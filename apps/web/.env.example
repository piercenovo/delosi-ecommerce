# Base URL of the products API (no trailing slash needed)
PRODUCTS_API_BASE_URL=https://fakestoreapi.com
# Public URL of the storefront, used for canonical URLs and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for POST /api/revalidate (min. 16 characters)
REVALIDATE_SECRET=
# Snapshot fallback when the API fails: on (default) | off (only to test error pages)
CATALOG_SNAPSHOT_FALLBACK=on
# Product images: local (default: copies in public/, works offline) | remote (FakeStore URLs
# optimized by next/image; set in production). Read at build time.
PRODUCT_IMAGES=local
